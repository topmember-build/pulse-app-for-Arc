# Privy client and server configuration
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Arc RPC configuration
ARC_RPC_URL=
ARC_CHAIN_ID=

# Reserved for the Arc Studio payment phase
PULSE_RECEIVING_ADDRESS=

# Deep scan payments (USDC). Deep scans stay disabled until a receiving address is set.
# PULSE_RECEIVING_ADDRESS (above) must be a wallet you control.
PULSE_DEEP_SCAN_PRICE_USDC=0.001
# Defaults to Arc Testnet. Override all of these together to charge on another network.
# PULSE_PAYMENT_RPC_URL is sent to every visitor's browser: use a public URL with no API key in it.
PULSE_PAYMENT_CHAIN_ID=
PULSE_PAYMENT_CHAIN_NAME=
PULSE_PAYMENT_RPC_URL=
PULSE_PAYMENT_EXPLORER_URL=
PULSE_PAYMENT_USDC_ADDRESS=

# Optional: spacing between RPC requests in milliseconds. Defaults to 230 for the public Arc RPC.
# Lower it (for example 20) when ARC_RPC_URL points at a dedicated provider.
ARC_RPC_MIN_GAP_MS=

# Optional: RPC used only for eth_getLogs. Defaults to the public Arc RPC, because some paid plans
# (for example Alchemy's free tier) limit eth_getLogs to a tiny block range.
ARC_LOGS_RPC_URL=

# Optional: address of the deployed PulseScanPayments contract. When set, deep scans are paid through it
# (one transaction, tied to the exact scan onchain). Leave empty to use a plain USDC transfer.
PULSE_PAYMENT_CONTRACT=
